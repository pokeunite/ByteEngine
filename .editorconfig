root = true

# ByteEngine formatting baseline.
#
# The goal is to stop density drift, not to reformat history. Rules that would
# rewrite most of the tree (line endings, member ordering) are intentionally
# left as suggestions or unset.
#
# Line length is a review signal: 240 columns keeps long engine signatures and
# shader-facing tables readable without turning every argument list into a
# vertical stack. New code should stay at or below it.

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 240

[*.cs]
indent_size = 4
tab_width = 4

# Braces: Allman is the established style across the engine and editor.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_prefer_braces = true:suggestion

# Namespaces: file-scoped is the established style and keeps diffs shallow.
csharp_style_namespace_declarations = file_scoped:warning

# Usings: System first, then ByteEngine and third-party groups.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion

# Keep explicit types where they document the API surface; var remains fine
# when the right-hand side already names the type.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Modifier order and modern language constructs.
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:suggestion
csharp_style_prefer_primary_constructors = false:suggestion

[*.{csproj,props,targets,sln,editorconfig}]
indent_size = 2
tab_width = 2

[*.{json,jsonc,yml,yaml}]
indent_size = 2
tab_width = 2

[*.{js,mjs,cjs}]
indent_size = 4
tab_width = 4

[*.ps1]
indent_size = 4
tab_width = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{bat,cmd}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,webp,ico,pdf,zip,gz,wasm,br}]
insert_final_newline = false
trim_trailing_whitespace = false
