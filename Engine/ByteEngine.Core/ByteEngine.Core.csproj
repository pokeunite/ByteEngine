<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNetter" Version="6.0.5" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" GeneratePathProperty="true" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
  </ItemGroup>

  <!--
    OpenTK.Audio.OpenAL provides bindings only. Windows does not normally ship
    OpenAL, so include OpenAL Soft's x64 runtime beside ByteEngine.

    Silk's native package publishes the library as soft_oal.dll. The editor
    publish script copies that file to OpenAL's conventional openal32.dll name,
    which is what OpenTK resolves on Windows.
  -->
  <ItemGroup>
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)\runtimes\win-x64\native\soft_oal.dll" Link="soft_oal.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(PkgSilk_NET_OpenAL_Soft_Native)\runtimes\win-x64\native\soft_oal.dll')" />
  </ItemGroup>

  <!-- Source identity survives Debug/Release and PDB differences while rejecting stale browser gameplay. -->
  <Target Name="FingerprintEngineSources" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_FingerprintSource Include="@(Compile)" Exclude="obj/**;bin/**;$(IntermediateOutputPath)**" />
      <_FingerprintSource Include="$(MSBuildProjectFile)" />
    </ItemGroup>
    <GetFileHash Files="@(_FingerprintSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_FingerprintHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)engine-source-fingerprint.txt" Lines="@(_FingerprintHash->'%(Filename)%(Extension)=%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <GetFileHash Files="$(IntermediateOutputPath)engine-source-fingerprint.txt" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_EngineSourceFingerprint" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ByteEngineSourceFingerprint</_Parameter1>
        <_Parameter2>$(_EngineSourceFingerprint)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
