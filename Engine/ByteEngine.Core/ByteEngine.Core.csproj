<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ThirdPartyNotices/**/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="AssimpNetter" Version="6.0.5" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" GeneratePathProperty="true" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
  </ItemGroup>

  <!--
    OpenTK.Audio.OpenAL provides bindings only. Windows does not normally ship
    OpenAL, so include OpenAL Soft's x64 runtime beside ByteEngine.

    Silk's native package publishes the library as soft_oal.dll. The editor
    publish script copies that file to OpenAL's conventional openal32.dll name,
    which is what OpenTK resolves on Windows.
  -->
  <ItemGroup>
    <None Include="$(PkgSilk_NET_OpenAL_Soft_Native)\runtimes\win-x64\native\soft_oal.dll" Link="soft_oal.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(PkgSilk_NET_OpenAL_Soft_Native)\runtimes\win-x64\native\soft_oal.dll')" />
  </ItemGroup>

  <UsingTask TaskName="ComputeByteNetworkIdentity" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup><Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true"/><Root ParameterType="System.String" Required="true"/><OutputFile ParameterType="System.String" Required="true"/></ParameterGroup>
    <Task><Using Namespace="System"/><Using Namespace="System.IO"/><Using Namespace="System.Linq"/><Using Namespace="System.Text"/><Using Namespace="System.Security.Cryptography"/>
      <Code Type="Fragment" Language="cs"><![CDATA[
        string root = Path.GetFullPath(Root);
        var files = Sources.Select(s => Path.GetFullPath(s.ItemSpec)).Where(p => p.StartsWith(root + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
            .Where(p => { var relative = p.Substring(root.Length + 1).Replace('\\','/'); return !relative.StartsWith("obj/") && !relative.StartsWith("bin/"); }).Distinct().OrderBy(p => p, StringComparer.Ordinal).ToArray();
        var text = new StringBuilder();
        foreach(var file in files) { text.Append(file.Substring(root.Length+1).Replace('\\','/')).Append('\n').Append(File.ReadAllText(file).Replace("\r\n","\n")).Append('\n'); }
        text.Append(File.ReadAllText(Path.Combine(root,"ByteEngine.Core.csproj")).Replace("\r\n","\n"));
        string hash; using(var sha = SHA256.Create()) hash = BitConverter.ToString(sha.ComputeHash(Encoding.UTF8.GetBytes(text.ToString()))).Replace("-","").ToLowerInvariant();
        string content = "// Generated: portable engine-source identity, independent of target assembly MVID.\nnamespace ByteEngine.Core.Net { public static class NetworkBuildIdentity { public const string Value = \"" + hash + "\"; } }\n";
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        if(!File.Exists(OutputFile) || File.ReadAllText(OutputFile)!=content) File.WriteAllText(OutputFile,content);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateByteNetworkIdentity" BeforeTargets="CoreCompile">
    <ComputeByteNetworkIdentity Sources="@(Compile)" Root="$(MSBuildProjectDirectory)" OutputFile="$(IntermediateOutputPath)NetworkBuildIdentity.g.cs"/>
    <ItemGroup><Compile Include="$(IntermediateOutputPath)NetworkBuildIdentity.g.cs"/></ItemGroup>
  </Target>
</Project>
