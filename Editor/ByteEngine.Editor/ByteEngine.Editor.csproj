<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Engine\ByteEngine.Core\ByteEngine.Core.csproj" />
    <!-- Read-only, version-matched assistant reference; never executed as generated code. -->
    <EmbeddedResource Include="../../Engine/ByteEngine.Core/**/*.cs" Exclude="../../Engine/ByteEngine.Core/obj/**;../../Engine/ByteEngine.Core/bin/**" LogicalName="ByteAssistant.Reference.Core.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../Docs/Top-Down-Controller.md" LogicalName="ByteAssistant.Reference.Docs.Top-Down-Controller.md" />
    <EmbeddedResource Include="../../Docs/VFX-Authoring.md" LogicalName="ByteAssistant.Reference.Docs.VFX-Authoring.md" />
    <EmbeddedResource Include="../../Docs/Built-in-Scene-Shaders.md" LogicalName="ByteAssistant.Reference.Docs.Built-in-Scene-Shaders.md" />
    <EmbeddedResource Include="../../Docs/PLUGIN-AUTHORING.md;../../Docs/Reusable-Game-Systems.md;../../Docs/Native-Water-System.md;../../Docs/GRAPHICS-QUALITY.md;../../Docs/Blueprint-Camera-Authoring-Implementation.md;../../Docs/Event toolkit implementation.txt;../../Docs/First-Person-Camera.md" LogicalName="ByteAssistant.Reference.Docs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../Docs/AI-Perception-Tactics-and-Combat.md;../../Docs/AI-Behaviour-Workshop.md;../../Docs/Gun-Projectiles-and-Trails.md;../../Docs/Model-Attachment-Points.md;../../Docs/Weapon-Setup-Tutorial.md;../../Docs/Weapon-Locomotion.md;../../Docs/Combat-Feedback-and-Audio.md;../../Docs/Crownback-Openings.md;../../Docs/Navigation-and-Fireball.md" LogicalName="ByteAssistant.Reference.Docs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../Plugins/KarlsonDemo/*.cs" LogicalName="ByteAssistant.Reference.Plugins.KarlsonDemo.%(Filename)%(Extension)" />
    <Content Include="Resources\Fonts\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources\Starters\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources\Characters\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="OpenTK" Version="4.9.4" />

    <!--
      OpenTK.Audio.OpenAL is managed bindings only. Windows does not normally
      provide OpenAL, so the editor directly restores OpenAL Soft's native
      runtime as a publish dependency.
    -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\Resources\Branding\ByteEngine.ico</ApplicationIcon>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>

    <!--
      Silk's package names the Windows OpenAL Soft binary soft_oal.dll.
      OpenTK 4.x resolves the conventional Windows OpenAL name openal32.dll.
    -->
    <ByteEngineOpenALSoftPath>$(NuGetPackageRoot)silk.net.openal.soft.native\1.23.1\runtimes\win-x64\native\soft_oal.dll</ByteEngineOpenALSoftPath>
  </PropertyGroup>

  <Target Name="CopyByteEngineOpenALSoftAfterBuild"
          AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and Exists('$(ByteEngineOpenALSoftPath)')">
    <Copy SourceFiles="$(ByteEngineOpenALSoftPath)"
          DestinationFiles="$(TargetDir)openal32.dll"
          SkipUnchangedFiles="true" />
    <Message Importance="high"
             Text="ByteEngine: copied OpenAL Soft to $(TargetDir)openal32.dll" />
  </Target>

  <Target Name="CopyByteEngineOpenALSoftAfterPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and Exists('$(ByteEngineOpenALSoftPath)')">
    <Copy SourceFiles="$(ByteEngineOpenALSoftPath)"
          DestinationFiles="$(PublishDir)openal32.dll"
          SkipUnchangedFiles="true" />
    <Message Importance="high"
             Text="ByteEngine: copied OpenAL Soft to $(PublishDir)openal32.dll" />
  </Target>

  <Target Name="ValidateByteEngineOpenALSoft"
          BeforeTargets="Build"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and !Exists('$(ByteEngineOpenALSoftPath)')">
    <Error Text="ByteEngine OpenAL Soft runtime is missing at '$(ByteEngineOpenALSoftPath)'. Run dotnet restore before building." />
  </Target>

  <ItemGroup>
    <Compile Include="../../Resources/Branding/NativeIdentity.cs" Link="Branding/NativeIdentity.cs" />
    <EmbeddedResource Include="../../Resources/Branding/ByteEngine.png" LogicalName="ByteEngine.Window.png" />
  </ItemGroup>
</Project>
